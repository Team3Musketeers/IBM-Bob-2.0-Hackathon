# Ghostwriter Live Service Configuration Example
# Copy this file to .env and fill in your actual credentials.
#
#   cp .env.example .env

# Gemini's OpenAI-compatible endpoint. Get a free key (no credit card) at
# https://aistudio.google.com/apikey
LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Model must be a model ID your key can actually reach. Current default:
#   gemini-3.5-flash-lite
# Note: gemini-2.5-flash-lite (and other older 2.x IDs) now return
# "no longer available to new users" -> HTTP 404 on every request.
# To see what YOUR key can call:
#   curl "https://generativelanguage.googleapis.com/v1beta/models" \
#        -H "x-goog-api-key: $LLM_API_KEY"
LLM_MODEL=gemini-3.5-flash-lite

LLM_API_KEY=your_gemini_api_key_here

# Must match the port you open in the browser AND the Dockerfile's
# ENV PORT / EXPOSE. The README, .env, and image all use 3000.
PORT=3000

# Optional. Raises the 60/hour unauthenticated GitHub PR-lookup cap.
# GITHUB_TOKEN=

# Optional. Where the bundled PR diffs live, for GET /api/dataset-diff/:pr.
# Unset: auto-detects ./dataset, then ../dataset.
# DATASET_DIR=../dataset

# Optional. Rate limit on POST /api/audit, per client IP. Each audit costs
# 5 model calls, and the endpoint is unauthenticated. Set RATE_LIMIT_MAX=0
# to disable entirely (e.g. for local load-testing).
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=600000
